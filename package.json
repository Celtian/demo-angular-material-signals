{
  "name": "demo-angular-material-signals",
  "version": "0.0.0",
  "author": {
    "name": "Dominik Hladík",
    "email": "dominik.hladik@seznam.cz",
    "url": "https://github.com/Celtian"
  },
  "license": "MIT",
  "private": true,
  "description": "Demo of angular material signals",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "create-version": "npx package-version-info -o src/app/version.ts",
    "postinstall": "yarn create-version",
    "i18n:extract": "transloco-keys-manager extract --sort --unflat --langs en cs --default-value '███' --remove-extra-keys --output public/i18n",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "postversion": "git push && git push --follow-tags",
    "release:major": "git checkout master && npm version major -m \"chore(update): major release %s 💥 \"",
    "release:minor": "git checkout master && npm version minor -m \"chore(update): release %s 🚀\"",
    "release:patch": "git checkout master && npm version patch -m \"chore(update): patch release %s 🐛 \"",
    "fix-vulnerabilities": "npx yarn-audit-fix && npx browserslist --update-db"
  },
  "dependencies": {
    "@angular/cdk": "21.2.4",
    "@angular/common": "^21.2.6",
    "@angular/compiler": "^21.2.6",
    "@angular/core": "^21.2.6",
    "@angular/forms": "^21.2.6",
    "@angular/material": "21.2.4",
    "@angular/platform-browser": "^21.2.6",
    "@angular/router": "^21.2.6",
    "@angular/service-worker": "^21.2.6",
    "@jsverse/transloco": "^8.2.1",
    "@jsverse/transloco-persist-lang": "^8.2.1",
    "ngx-app-version": "^2.2.0",
    "ngx-fixed-footer": "^4.1.0",
    "ngx-update-app": "^2.1.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "xng-breadcrumb": "^15.0.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.3.1",
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.6",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-angular": "^20.5.0",
    "@eslint/js": "^9.39.2",
    "@jsverse/transloco-keys-manager": "^8.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "angular-eslint": "21.3.1",
    "auto-changelog": "^2.5.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "package-version-info": "^0.0.6",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  }
}
