{
  "name": "demo-angular-material-signals",
  "version": "0.0.0",
  "author": {
    "name": "Dominik Hladík",
    "email": "dominik.hladik@seznam.cz",
    "url": "https://github.com/Celtian"
  },
  "license": "MIT",
  "private": true,
  "description": "Demo of angular material signals",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "create-version": "package-version-info -o src/app/version.ts",
    "postinstall": "yarn create-version",
    "i18n:extract": "transloco-keys-manager extract --sort --unflat --langs en cs --default-value '███' --remove-extra-keys --output public/i18n",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "postversion": "git push && git push --follow-tags",
    "release:major": "git checkout master && npm version major -m \"chore(update): major release %s 💥 \"",
    "release:minor": "git checkout master && npm version minor -m \"chore(update): release %s 🚀\"",
    "release:patch": "git checkout master && npm version patch -m \"chore(update): patch release %s 🐛 \"",
    "fix-vulnerabilities": "npx yarn-audit-fix && npx browserslist --update-db"
  },
  "dependencies": {
    "@angular/cdk": "22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/material": "22.0.6",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/service-worker": "^22.0.8",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-persist-lang": "^8.4.0",
    "ngx-app-version": "^3.0.1",
    "ngx-fixed-footer": "^5.0.1",
    "ngx-update-app": "^3.0.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "xng-breadcrumb": "^15.0.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-angular": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-keys-manager": "^8.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "22.1.0",
    "auto-changelog": "^2.6.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.2.0",
    "package-version-info": "^0.3.0",
    "postcss": "^8.5.24",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "@typescript-eslint/utils": "8.62.0"
  }
}
